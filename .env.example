# Copy to .env.local for local development. Never commit real values.

# Postgres on Neon (pooled connection string). Leave empty locally to use PGlite.
DATABASE_URL=

# Local PGlite folder used when DATABASE_URL is empty (gitignored).
PGLITE_DIR=./.pglite

# Better Auth: at least 32 random characters (`openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# Public URL of the app (http://localhost:3000 locally, https://<domain> in production).
BETTER_AUTH_URL=http://localhost:3000

# Closed sign-up: comma-separated emails allowed to create an account.
SIMCAL_ALLOWED_EMAILS=moi@exemple.fr
